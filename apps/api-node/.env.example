# Optional: copy to .env here, or use repo-root ../../.env (loaded first).
# Full reference: ../../.env.example and PRODUCTION.md §6.2 / §10.4

# Listen address. Default :8788. On cPanel / Passenger, leave unset and use the host's PORT, or set API_ADDR explicitly (e.g. 0.0.0.0:PORT from their docs).
API_ADDR=:8788

APP_BASE_URL=http://localhost:4321
# APP_ORIGIN_ALLOWLIST=https://your-domain.com

DATABASE_URL=postgres://signal:story@localhost:5433/signal_and_story?sslmode=disable

SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_USER=any
SMTP_PASS=any
SMTP_FROM="Signal & Story <hello@signal-and-story.local>"

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:4321/checkout/success
STRIPE_CANCEL_URL=http://localhost:4321/checkout

BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Signal & Story

BETTER_AUTH_SECRET=
AUTH_BASE_URL=http://localhost:8787/api/auth

ADMIN_EMAIL=
PUBLIC_ADMIN_EMAIL=
