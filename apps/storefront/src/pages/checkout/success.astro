---
export const prerender = false;

import Base from "../../layouts/Base.astro";
import { apiBase } from "../../lib/api";

const stripeSessionId = Astro.url.searchParams.get("session_id")?.trim() || "";
const legacyInternalId = Astro.url.searchParams.get("checkout_session_id")?.trim() || "";

type LineItem = {
  name: string;
  quantity: number;
  unit_price_cents: number;
  line_total_cents: number;
};

type Details = {
  source: string;
  email: string;
  currency: string;
  total_cents: number;
  line_items: LineItem[];
  shipping_cents: number;
};

let details: Details | null = null;
let loadError: string | null = null;

if (stripeSessionId || legacyInternalId) {
  const q = stripeSessionId
    ? `session_id=${encodeURIComponent(stripeSessionId)}`
    : `checkout_session_id=${encodeURIComponent(legacyInternalId)}`;
  try {
    const res = await fetch(`${apiBase}/api/checkout/success-details?${q}`, {
      headers: { accept: "application/json" },
    });
    if (res.ok) {
      details = (await res.json()) as Details;
    } else {
      const j = (await res.json().catch(() => ({}))) as { error?: string };
      loadError = j.error || `HTTP ${res.status}`;
    }
  } catch {
    loadError = "unreachable";
  }
} else {
  loadError = "missing_session";
}

function fmtMoney(cents: number, currency: string): string {
  const c = (currency || "GBP").toUpperCase();
  if (c === "GBP") return `£${(Number(cents) / 100).toFixed(2)}`;
  return `${(Number(cents) / 100).toFixed(2)} ${c}`;
}
---
<Base title="Order confirmed — Signal & Story">
  <section class="card" style="padding:18px;max-width:640px;margin:0 auto">
    <div class="tag" style="display:inline-flex;gap:8px;align-items:center;border-color:rgba(34,211,238,.35)">
      <span style="width:8px;height:8px;border-radius:999px;background:var(--neon2);box-shadow:0 0 20px rgba(34,211,238,.45)"></span>
      Order confirmed
    </div>

    {details ? (
      <>
        <h1 style="margin:14px 0 0 0;font-size:28px">Thank you</h1>
        <p style="color:var(--muted);line-height:1.7;margin-top:10px">
          Your payment was successful. We’ve sent a confirmation email
          {details.email ? (
            <>
              {" "}
              to <strong>{details.email}</strong>
            </>
          ) : null}
          — please check your inbox (and spam) for the full receipt.
        </p>

        {details.email ? (
          <div class="tag" style="margin-top:12px">
            Customer email: <strong>{details.email}</strong>
          </div>
        ) : null}

        <div style="height:18px"></div>
        <h2 style="margin:0;font-size:16px">Items</h2>
        <div style="height:10px"></div>
        <div style="display:grid;gap:8px">
          {details.line_items.length ? (
            details.line_items.map((it) => (
              <div
                class="card"
                style="padding:12px;display:flex;justify-content:space-between;gap:12px;align-items:flex-start;flex-wrap:wrap"
              >
                <div>
                  <div style="font-weight:700">{it.name}</div>
                  <div style="color:var(--muted);font-size:12px;margin-top:4px">
                    {it.quantity} × {fmtMoney(it.unit_price_cents, details.currency)} each
                  </div>
                </div>
                <div class="tag">{fmtMoney(it.line_total_cents, details.currency)}</div>
              </div>
            ))
          ) : (
            <div class="tag">Line item details are not available for this session.</div>
          )}
        </div>

        {details.shipping_cents > 0 ? (
          <div style="margin-top:12px;display:flex;justify-content:space-between;align-items:center">
            <span style="color:var(--muted)">Shipping (in checkout)</span>
            <span class="tag">{fmtMoney(details.shipping_cents, details.currency)}</span>
          </div>
        ) : null}

        <div
          style="margin-top:16px;padding-top:14px;border-top:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;gap:12px"
        >
          <span style="font-weight:800">Total paid</span>
          <span style="font-weight:900;font-size:20px">{fmtMoney(details.total_cents, details.currency)}</span>
        </div>
      </>
    ) : (
      <>
        <h1 style="margin:14px 0 0 0;font-size:28px">Thanks — almost there</h1>
        <p style="color:var(--muted);line-height:1.7;margin-top:10px">
          {loadError === "missing_session"
            ? "This page needs a Stripe session reference. If you just paid, open the link from your Stripe receipt email or return from checkout again."
            : loadError === "unreachable"
              ? `We couldn’t reach the API at ${apiBase} to load your receipt. If payment went through, you’ll still get a confirmation email.`
              : `We couldn’t load your order summary (${loadError}). If payment completed, check your email for confirmation.`}
        </p>
      </>
    )}

    <div style="height:20px"></div>
    <div style="display:flex;gap:10px;flex-wrap:wrap">
      <a class="btn" href="/collections/all">Keep browsing</a>
      <a class="btn secondary" href="/account">View order history</a>
    </div>
  </section>

  <script is:inline>
    try {
      window.cart?.write?.([]);
      localStorage.removeItem("sas_cart_v1");
      window.cart?.write?.([]);
    } catch {}
  </script>
</Base>
