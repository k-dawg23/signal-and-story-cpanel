---
export const prerender = false;

import Base from "../../layouts/Base.astro";
import { safeGetJSON } from "../../lib/api";
import { renderProductDescription } from "../../lib/markdown";

const { handle } = Astro.params;
const data = await safeGetJSON<{ product: any | null }>(
  `/api/products/${encodeURIComponent(handle ?? "")}`,
  { product: null }
);
const p = data.product;
const price = p ? `£${(p.price_cents / 100).toFixed(2)}` : "";
const descHtml = p ? renderProductDescription(p.description_md ?? "") : "";
const imageUrl = p?.image_url ? String(p.image_url) : "";
---
<Base title={`${p?.name ?? "Product"} — Signal & Story`}>
  {p ? (
  <div class="grid cols2" style="align-items:start">
    <div class="productMedia productHero">
      {imageUrl ? (
        <img
          src={imageUrl}
          alt={p.name}
          loading="eager"
          decoding="async"
          onerror="this.remove()"
          class="productHeroImg"
        />
      ) : null}
    </div>
    <section class="card" style="padding:16px;display:grid;gap:12px">
      <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap">
        <span class="tag" style="border-color: rgba(168,85,247,.35)">Premium</span>
        <span class="tag">Universe‑inspired</span>
      </div>
      <h1 style="margin:0;line-height:1.1">{p.name}</h1>
      <div class="tag" style="display:inline-flex;width:max-content;border-color: rgba(34,211,238,.35)">{price}</div>
      <div style="color:var(--muted);line-height:1.7" set:html={descHtml} />
      <div style="display:flex;gap:10px;flex-wrap:wrap">
        <button class="btn" type="button" onclick={`window.cart.addAndNotify(${JSON.stringify(p)})`}>Add to cart</button>
        <button class="btn secondary" type="button" onclick="window.cart.openDrawer()">Open cart</button>
      </div>
    </section>
  </div>
  ) : (
    <div class="card" style="padding:14px">
      <div style="font-weight:800">Product unavailable</div>
      <div style="color:var(--muted);margin-top:6px">Run <code>npm run dev</code> in <code>apps/api-node</code> or <code>./scripts/dev.sh</code> from the repo root to load product details.</div>
      <div style="height:10px"></div>
      <a class="btn secondary" href="/collections/all">Back to catalog</a>
    </div>
  )}
</Base>

