---
export const prerender = false;

import Base from "../layouts/Base.astro";
import ProductCard from "../components/ProductCard.astro";
import { safeGetJSON } from "../lib/api";

const q = Astro.url.searchParams.get("q") ?? "";
const data = q
  ? await safeGetJSON<{ products: any[] }>(`/api/products?q=${encodeURIComponent(q)}`, { products: [] })
  : { products: [] };
---
<Base title="Search — Signal & Story">
  <h1 style="margin:0">Search</h1>
  <p style="color:var(--muted);margin-top:10px;line-height:1.6">Find artifacts by name, vibe, or description.</p>

  <div style="height:12px"></div>

  <form method="get" action="/search" class="card" style="padding:14px;display:flex;gap:10px;flex-wrap:wrap">
    <label class="sr" for="q">Search</label>
    <input id="q" name="q" value={q} placeholder="Try: neon, rune, delay, cable..." style="flex:1;min-width:220px;padding:12px 12px;border-radius:12px;border:1px solid var(--line);background:rgba(0,0,0,.25);color:var(--text)" />
    <button class="btn" type="submit">Search</button>
  </form>

  <div style="height:12px"></div>

  {q ? (
    data.products.length ? (
      <div class="grid cols3">
        {data.products.map((p) => <ProductCard product={p} />)}
      </div>
    ) : (
      <div class="card" style="padding:14px">
        <div style="font-weight:800">No results (or catalog offline)</div>
        <div style="color:var(--muted);margin-top:6px">If the API isn’t running, search can’t query products.</div>
      </div>
    )
  ) : (
    <div class="tag">Type a search term to begin.</div>
  )}
</Base>

