---
export const prerender = false;

import Base from "../../layouts/Base.astro";
import ProductCard from "../../components/ProductCard.astro";
import { apiBase, tryGetJSON } from "../../lib/api";

const { data, ok: catalogOk } = await tryGetJSON<{ products: any[] }>("/api/products", { products: [] });
---
<Base title="All Products — Signal & Story">
  <div style="display:flex;align-items:end;justify-content:space-between;gap:10px;flex-wrap:wrap">
    <div>
      <h1 style="margin:0">All products</h1>
      <div style="color:var(--muted);font-size:13px;margin-top:8px">Every artifact in the catalog.</div>
    </div>
    <a class="tag" href="/search">Search</a>
  </div>
  <div style="height:12px"></div>
  {data.products.length ? (
    <div class="grid cols3">
      {data.products.map((p) => <ProductCard product={p} />)}
    </div>
  ) : !catalogOk ? (
    <div class="card" style="padding:14px">
      <div style="font-weight:800">Cannot reach the API</div>
      <div style="color:var(--muted);margin-top:6px;line-height:1.6">
        Could not load <code>{apiBase}/api/products</code>. Start <code>apps/api-node</code> (e.g. <code>./scripts/dev.sh</code>). In dev, remote <code>PUBLIC_API_BASE</code> values are ignored unless <code>PUBLIC_SAS_REMOTE=1</code>.
      </div>
    </div>
  ) : (
    <div class="card" style="padding:14px">
      <div style="font-weight:800">No products in the catalog</div>
      <div style="color:var(--muted);margin-top:6px">
        Run <code>SAS_SEED_PRODUCTS=1 ./scripts/db-reset-and-seed.sh</code> or add products in Admin.
      </div>
    </div>
  )}
</Base>

