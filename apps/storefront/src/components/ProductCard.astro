---
const { product } = Astro.props;
const price = `£${(product.price_cents / 100).toFixed(2)}`;
---
<div class="card" style="padding:14px;display:grid;gap:10px">
  <a href={`/products/${product.handle}`} style="display:grid;gap:10px">
    <div class="card" style="height:150px;border-radius:14px;overflow:hidden;background:linear-gradient(135deg, rgba(168,85,247,.16), rgba(34,211,238,.08));border:1px solid rgba(255,255,255,.08)"></div>
    <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:10px">
      <div>
        <div style="font-weight:800">{product.name}</div>
        <div style="font-size:12px;color:var(--muted);margin-top:4px">Gear that belongs to a universe.</div>
      </div>
      <div class="tag" style="border-color: rgba(168,85,247,.35)">{price}</div>
    </div>
  </a>
  <button class="btn" type="button" onclick={`window.cart.add(${JSON.stringify(product)})`} style="width:100%">
    Add to cart
  </button>
</div>

