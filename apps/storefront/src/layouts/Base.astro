---
import "../styles/global.css";

const { title = "Signal & Story", description = "Gear for Every Universe" } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script is:inline>
      // Load HTMX + Alpine from CDN for now (swap to local later if desired)
      window.__SAS__ = { apiBase: (import.meta.env.PUBLIC_API_BASE || "http://127.0.0.1:8788") };
    </script>
    <script src="https://unpkg.com/htmx.org@2.0.3"></script>
    <script src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
    <script src="/scripts/cart.js" defer></script>
  </head>
  <body>
    <header class="container" style="display:flex;align-items:center;justify-content:space-between;gap:14px">
      <a href="/" style="display:flex;align-items:center;gap:10px">
        <div class="card" style="width:40px;height:40px;border-radius:14px;display:grid;place-items:center;border:1px solid rgba(168,85,247,.45);background:rgba(168,85,247,.12)">
          <span style="font-weight:800;letter-spacing:.02em">S</span>
        </div>
        <div>
          <div style="font-weight:800;letter-spacing:.02em">Signal &amp; Story</div>
          <div style="font-size:12px;color:var(--muted)">Where Sound Meets Story</div>
        </div>
      </a>
      <nav style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;justify-content:flex-end">
        <a class="tag" href="/collections">Collections</a>
        <a class="tag" href="/search">Search</a>
        <a class="tag" href="/account">Account</a>
        <button class="btn secondary" type="button" x-data @click="window.cart?.openDrawer()">
          Cart <span class="tag" x-text="window.cart?.count() ?? 0"></span>
        </button>
      </nav>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="container" style="padding-bottom:32px;color:var(--muted);display:flex;gap:14px;flex-wrap:wrap;justify-content:space-between;align-items:center">
      <div>© {new Date().getFullYear()} Signal &amp; Story</div>
      <div style="display:flex;gap:10px;flex-wrap:wrap">
        <span class="tag">Gear for Every Universe</span>
        <span class="tag">Play Beyond Reality</span>
      </div>
    </footer>

    <div id="cart-drawer" class="card" style="position:fixed;top:0;right:-420px;max-width:420px;width:92vw;height:100vh;z-index:50;transition:right .25s ease;border-radius:0;border-left:1px solid var(--line);background:linear-gradient(180deg, rgba(10,8,16,.98), rgba(10,8,16,.92));padding:14px;overflow:auto">
      <div style="display:flex;align-items:center;justify-content:space-between;gap:10px">
        <div style="font-weight:800">Your Cart</div>
        <button class="btn secondary" type="button" onclick="window.cart?.closeDrawer()">Close</button>
      </div>
      <div style="height:10px"></div>
      <div id="cart-drawer-items"></div>
      <div style="height:12px"></div>
      <a class="btn" href="/cart" style="width:100%">View cart</a>
    </div>
  </body>
</html>

