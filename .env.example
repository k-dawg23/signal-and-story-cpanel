# Shared
APP_ENV=development
APP_BASE_URL=http://localhost:4321
# Extra storefront origins (prod or non-default hosts), comma-separated
# APP_ORIGIN_ALLOWLIST=https://your-domain.com,https://www.your-domain.com

# Postgres
DATABASE_URL=postgres://signal:story@localhost:5433/signal_and_story?sslmode=disable

# Mail (dev via Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_USER=any
SMTP_PASS=any
SMTP_FROM="Signal & Story <hello@signal-and-story.local>"

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:4321/checkout/success
STRIPE_CANCEL_URL=http://localhost:4321/checkout

# Brevo (prod; optional in dev)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Signal & Story

# Better Auth (auth service)
BETTER_AUTH_SECRET=
AUTH_BASE_URL=http://localhost:8787/api/auth
# Production (subdomain split): parent hostname so session cookies reach api.* + apex storefront
# AUTH_COOKIE_DOMAIN=signal-and-story.k-dawg.uk

# Admin
ADMIN_EMAIL=kenneth.rough@gmail.com
PUBLIC_ADMIN_EMAIL=kenneth.rough@gmail.com

# Dev helpers
# Seed the sample catalog on startup (won't wipe admin collection assignments)
SAS_SEED_PRODUCTS=0

